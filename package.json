{
  "name": "bilibili-ad-skipper",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "build": "npm run clean && vite build --config vite.options.config.ts && vite build --config vite.content.config.ts && vite build --config vite.background.config.ts",
    "dev": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test && npm run build",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\"",
    "test:e2e": "node scripts/e2e-extension.mjs && node scripts/e2e-skip.mjs",
    "test:e2e:skip": "node scripts/e2e-skip.mjs",
    "icons": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-icons.ps1"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.6",
    "@types/node": "^24.7.2",
    "jsdom": "^27.0.0",
    "playwright-core": "^1.56.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
